# Copy to .env for local runs (`export $(cat .env | xargs)` or use direnv).
# Not needed at all if you just want to run against the bundled local
# sample data -- the app falls back to that automatically.

GCP_PROJECT_ID=voc-dane
GCP_LOCATION=us
BQ_DATASET=voc_analytics
BQ_TABLE=enriched_calls
VERTEX_MODEL_NAME=gemini-3.8-flash
