# Copy to .env for local runs (`export $(cat .env | xargs)` or use direnv).
# Not needed at all if you just want to run against the bundled local
# sample data -- the app falls back to that automatically.

GCP_PROJECT_ID=voc-dane
GCP_LOCATION=us
BQ_DATASET=voc_analytics
BQ_TABLE=enriched_calls
VERTEX_MODEL_NAME=gemini-3.8-flash

# Optional: gates the app behind a name + this shared access code, and logs
# logins/activity to BigQuery. Leave unset for a frictionless local dev login.
APP_ACCESS_CODE=

# Optional: USD per 1M tokens, for estimated_cost_usd in
# voc_analytics.vertex_usage_log. Defaults to gemini-3.8-flash non-global
# pricing as of 2026-09-20 ($0.825 in / $4.125 out) if left unset -- override
# here for a different model, or once pricing changes (this rate is valid
# through Dec 31, 2026; see pipeline/usage_log.py).
VERTEX_PRICE_INPUT_PER_1M=
VERTEX_PRICE_OUTPUT_PER_1M=
